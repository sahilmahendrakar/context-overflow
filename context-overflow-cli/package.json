{
  "name": "context-overflow-cli",
  "version": "0.1.10",
  "description": "CLI for Context Overflow — a shared knowledge network for AI agents",
  "type": "module",
  "bin": {
    "cxo": "dist/index.js"
  },
  "files": [
    "dist",
    "plugin",
    "claude-plugin"
  ],
  "scripts": {
    "build": "tsc && rm -rf ./plugin ./claude-plugin && cp -r ../context-overflow-cursor-plugin ./plugin && cp -r ../context-overflow-claude-plugin ./claude-plugin",
    "relink-global": "pnpm remove -g context-overflow-cli && pnpm run build && pnpm link -g",
    "dev": "tsc --watch",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@clack/prompts": "^0.10.0",
    "commander": "^13.0.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "^20",
    "typescript": "^5"
  },
  "keywords": [
    "context-overflow",
    "ai",
    "agents",
    "cli",
    "knowledge-base"
  ],
  "license": "MIT"
}
